{
  "name": "fundamentos-de-la-programacion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "test:coverage": "node --experimental-strip-types --no-warnings --experimental-test-coverage --test-coverage-include=lib/quiz.ts --test-coverage-include=lib/sandbox.ts --test-coverage-include=lib/python-runner.ts --test-coverage-include=lib/typescript-runner.ts --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 --test tests/quiz.test.ts tests/sandbox.test.ts tests/python-runner.test.ts tests/typescript-runner.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "verify": "pnpm test && pnpm test:coverage && pnpm lint && pnpm build && pnpm test:e2e && pnpm verify:http",
    "verify:quiz": "node --experimental-strip-types --no-warnings --test tests/quiz.test.ts",
    "verify:http": "node scripts/smoke-http.mjs"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4"
  },
  "packageManager": "pnpm@11.1.2"
}
